        <mxCell id="c6_diamond" value="CONFIRM&#xa;LOGOUT?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontFamily=Arial;fontSize=9;fontStyle=1;align=center;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="905" y="350" width="120" height="55" as="geometry" />
        </mxCell>

        <mxCell id="c6_box2" value="TERMINATE SESSION&#xa;&amp; RETURN TO LOGIN" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontFamily=Arial;fontSize=9;fontStyle=1;align=center;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="900" y="435" width="130" height="38" as="geometry" />
        </mxCell>

        <mxCell id="e_c6_1_d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="c6_box1" target="c6_diamond">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c6_yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=8;fontColor=#000000;" edge="1" parent="1" source="c6_diamond" target="c6_box2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c6_2_bus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=none;" edge="1" parent="1" source="c6_box2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="965" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- NO branch loops cleanly back up to DASHBOARD right port -->
        <mxCell id="e_c6_no" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;fontSize=8;fontColor=#000000;" edge="1" parent="1" source="c6_diamond" target="dashboard">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1055" y="378" />
              <mxPoint x="1055" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== BOTTOM COLLECTION BUS & LOGOUT ==================== -->
        <!-- Horizontal Bottom Collection Bus (Y = 730) -->
        <mxCell id="bottom_bus_bar" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="75" y="730" as="sourcePoint" />
            <mxPoint x="965" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Terminator: LOGOUT (X_center = 565, Y = 760) -->
        <mxCell id="logout" value="LOGOUT" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontFamily=Arial;fontSize=10;fontStyle=1;align=center;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="515" y="760" width="100" height="35" as="geometry" />
        </mxCell>

        <!-- Final Arrow from Bottom Bus to Logout -->
        <mxCell id="e_bus_to_logout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" target="logout">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="565" y="730" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
